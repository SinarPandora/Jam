import o.lartifa.jam.ob.event.events.message.EventDiscussMessage
import o.lartifa.jam.ob.event.events.message.EventGroupMessage
import o.lartifa.jam.ob.event.events.message.EventPrivateMessage
import o.lartifa.jam.ob.sender.message.components.ComponentAt

if ($args.isEmpty()) {
    return
}

if ($msg instanceof EventPrivateMessage || $msg instanceof EventDiscussMessage) {
    return
}

target = $args.head().toLong()

shield = $vars.get("背刺盾_${target}").map(Integer::parseInt).orElse(0)

reply("🔍目标${new ComponentAt(target)}身上有${shield}层盾🛡")