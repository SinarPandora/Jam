import cc.moecraft.icq.sender.message.components.ComponentImageBase64
import cn.hutool.core.img.Img
import org.jsoup.Jsoup

filename = Jsoup.connect("https://random.dog/").get().getElementById("dog-img").attr("src")

reply("割藕")

try {
        out = new ByteArrayOutputStream()

        Img.from(new URL("https://random.dog/${filename}"))
                .scale(0.5)
                .setQuality(0.7)
                .write(out)

        image = Base64.encoder.encodeToString(out.toByteArray())

        reply(" ${new ComponentImageBase64(image).toString()}")
} catch (Throwable e) {
        reply("狗狗被我吃啦")
}

