/**
 * lambda<NAME>(%{目标QQ}%,%{时长}%)
 */
import o.lartifa.jam.onebot.domain.DiscussMessage
import o.lartifa.jam.onebot.domain.GroupMessage
import o.lartifa.jam.onebot.domain.PrivateMessage

import java.util.concurrent.TimeUnit
import o.lartifa.jam.onebot.cq.ComponentAt
if ($args.size() < 2) {
    return
}

if ($msg instanceof PrivateMessage || $msg instanceof DiscussMessage) {
    return
}

target = $args.head().toLong()
period = $args.get(1).toInteger()

shield = $vars.get("背刺盾_${target}").map(Integer::parseInt).orElse(0)

if (shield > 0) {
    $vars.updateOrElseSet("背刺盾_${target}", (shield - 1).toString())
    reply("🛡 但 ${new ComponentAt(target)} 的盾挡下了这个效果 🛡")
    return
} else {
    $api.setGroupBan(((GroupMessage) $msg).groupId(), target, TimeUnit.MINUTES.toSeconds(period))
}
